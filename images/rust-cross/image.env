# Every KEY=VALUE here except TAG and PLATFORMS is passed to `docker build` as --build-arg.
# TAG is the version part of the published tags: kensel/action-runners:rust-cross-<TAG>.
# Bump RUST_VERSION and TAG together, in step with RUST_TOOLCHAIN in the projects that use it.
TAG=1.98.0
PLATFORMS=linux/amd64
BASE_IMAGE=ubuntu:24.04
RUST_VERSION=1.98.0
RUST_TARGETS=x86_64-unknown-linux-musl armv7-unknown-linux-musleabihf aarch64-unknown-linux-musl
RUST_COMPONENTS=clippy rustfmt
NODE_MAJOR=24
